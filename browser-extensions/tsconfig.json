{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "types": ["chrome"],
    "outDir": "dist/js",
    "rootDir": "shared/src",
    "skipLibCheck": true
  },
  "include": ["shared/src/**/*.ts"]
}
