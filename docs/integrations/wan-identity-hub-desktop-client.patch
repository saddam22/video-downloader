diff --git a/server/test/native-client.test.ts b/server/test/native-client.test.ts
new file mode 100644
index 0000000..42f50a8
--- /dev/null
+++ b/server/test/native-client.test.ts
@@ -0,0 +1,145 @@
+import assert from "node:assert/strict";
+import { createHash, randomBytes } from "node:crypto";
+import { after, before, describe, it } from "node:test";
+import { createLocalJWKSet, jwtVerify } from "jose";
+import { Browser, harness, register, type Harness } from "./helpers.ts";
+
+/** WAN Download Manager: a public native client (RFC 8252) — no secret, loopback redirect, refresh tokens. */
+let h: Harness;
+before(async () => {
+  h = await harness();
+});
+after(async () => {
+  await h.close();
+});
+
+const CLIENT = "wan-download-manager";
+const ISSUER = "http://localhost:4100/oidc";
+const FORM = { "content-type": "application/x-www-form-urlencoded" };
+
+function pkce() {
+  const verifier = randomBytes(32).toString("base64url");
+  return { verifier, challenge: createHash("sha256").update(verifier).digest("base64url") };
+}
+
+async function follow(b: Browser, url: string, redirect: string) {
+  let res = await b.get(url);
+  for (let i = 0; i < 10 && res.statusCode >= 300 && res.statusCode < 400; i++) {
+    const loc = String(res.headers.location);
+    if (loc.startsWith(redirect) || loc.startsWith("/#/")) return loc;
+    res = await b.get(loc.replace("http://localhost:4100", ""));
+  }
+  return res.headers.location ? String(res.headers.location) : null;
+}
+
+async function signIn(b: Browser, redirect = "http://127.0.0.1:53682/callback", scope = "openid profile email offline_access wan_entitlements") {
+  const { verifier, challenge } = pkce();
+  const q = new URLSearchParams({
+    client_id: CLIENT,
+    response_type: "code",
+    scope,
+    redirect_uri: redirect,
+    state: "s1",
+    nonce: "n1",
+    prompt: "consent",
+    code_challenge: challenge,
+    code_challenge_method: "S256",
+  });
+  const location = await follow(b, `/oidc/auth?${q}`, redirect);
+  return { location, verifier, redirect };
+}
+
+const post = (url: string, body: Record<string, string>) =>
+  h.app.inject({ method: "POST", url, headers: FORM, payload: new URLSearchParams(body).toString() });
+
+describe("WAN Download Manager (public native client)", () => {
+  it("is listed in discovery capabilities: no-secret auth, refresh, revocation, wan_entitlements", async () => {
+    const d = (await h.app.inject({ url: "/oidc/.well-known/openid-configuration" })).json();
+    assert.ok(d.token_endpoint_auth_methods_supported.includes("none"));
+    assert.ok(d.scopes_supported.includes("offline_access"));
+    assert.ok(d.scopes_supported.includes("wan_entitlements"));
+    assert.ok(d.claims_supported.includes("wan_entitlement"));
+    assert.equal(d.revocation_endpoint, `${ISSUER}/token/revocation`);
+  });
+
+  it("signs in through a loopback redirect on any port, exchanges the code without a secret and gets a refresh token", async () => {
+    const { browser, userId } = await register(h, { contact: "dm1@example.com", username: "dm_user1", fullName: "Nusrat Jahan" });
+    const { location, verifier, redirect } = await signIn(browser, "http://127.0.0.1:61001/callback");
+    assert.ok(location?.startsWith(redirect), `got ${location}`);
+    const code = new URL(location!).searchParams.get("code")!;
+    const res = await post("/oidc/token", { grant_type: "authorization_code", client_id: CLIENT, code, redirect_uri: redirect, code_verifier: verifier });
+    assert.equal(res.statusCode, 200, res.body);
+    const tokens = res.json();
+    assert.ok(tokens.refresh_token, "refresh token issued for offline_access");
+    const jwks = createLocalJWKSet((await h.app.inject({ url: "/oidc/jwks" })).json());
+    const { payload } = await jwtVerify(tokens.id_token, jwks, { issuer: ISSUER, audience: CLIENT });
+    assert.equal(payload.sub, userId);
+    assert.equal(payload.nonce, "n1");
+    const ent = payload.wan_entitlement as { platform: string; status: string; roles: string[] };
+    assert.equal(ent.platform, CLIENT);
+    assert.equal(ent.status, "active");
+    assert.deepEqual(ent.roles, ["free"]);
+
+    // userinfo with the bearer token carries the same claim.
+    const ui = await h.app.inject({ url: "/oidc/me", headers: { authorization: `Bearer ${tokens.access_token}` } });
+    assert.equal(ui.statusCode, 200, ui.body);
+    assert.equal(ui.json().wan_entitlement.status, "active");
+
+    // Refresh rotates the token; the old one is then refused.
+    const r1 = await post("/oidc/token", { grant_type: "refresh_token", client_id: CLIENT, refresh_token: tokens.refresh_token });
+    assert.equal(r1.statusCode, 200, r1.body);
+    assert.notEqual(r1.json().refresh_token, tokens.refresh_token);
+    const reused = await post("/oidc/token", { grant_type: "refresh_token", client_id: CLIENT, refresh_token: tokens.refresh_token });
+    assert.equal(reused.statusCode, 400);
+
+    // Revocation (sign-out) ends the refresh token.
+    const rt = r1.json().refresh_token;
+    assert.equal((await post("/oidc/token/revocation", { client_id: CLIENT, token: rt, token_type_hint: "refresh_token" })).statusCode, 200);
+    assert.equal((await post("/oidc/token", { grant_type: "refresh_token", client_id: CLIENT, refresh_token: rt })).statusCode, 400);
+  });
+
+  it("the entitlement claim reflects the platform's decision (pro tier, suspension)", async () => {
+    const { browser, userId } = await register(h, { contact: "dm2@example.com", username: "dm_user2" });
+    await h.db.query(
+      "insert into entitlements (user_id, platform_id, status, roles, granted_at) values ($1, $2, 'active', '{pro}', now())",
+      [userId, CLIENT],
+    );
+    const { location, verifier, redirect } = await signIn(browser);
+    const code = new URL(location!).searchParams.get("code")!;
+    const tokens = (await post("/oidc/token", { grant_type: "authorization_code", client_id: CLIENT, code, redirect_uri: redirect, code_verifier: verifier })).json();
+    const jwks = createLocalJWKSet((await h.app.inject({ url: "/oidc/jwks" })).json());
+    const { payload } = await jwtVerify(tokens.id_token, jwks, { issuer: ISSUER, audience: CLIENT });
+    assert.deepEqual((payload.wan_entitlement as { roles: string[] }).roles, ["pro"]);
+
+    await h.db.query("update entitlements set status = 'suspended' where user_id = $1 and platform_id = $2", [userId, CLIENT]);
+    const again = await signIn(browser);
+    assert.match(again.location ?? "", /error=access_denied/);
+  });
+
+  it("refuses: no PKCE, a non-loopback redirect, an http redirect to localhost name, and the Platform API", async () => {
+    const { browser } = await register(h, { contact: "dm3@example.com", username: "dm_user3" });
+    const noPkce = await browser.get(
+      `/oidc/auth?${new URLSearchParams({ client_id: CLIENT, response_type: "code", scope: "openid", redirect_uri: "http://127.0.0.1:5000/callback" })}`,
+    );
+    assert.match(String(noPkce.headers.location ?? noPkce.body), /code_challenge|invalid_request/);
+    const evil = await browser.get(
+      `/oidc/auth?${new URLSearchParams({ client_id: CLIENT, response_type: "code", scope: "openid", redirect_uri: "http://evil.example/callback", code_challenge: pkce().challenge, code_challenge_method: "S256" })}`,
+    );
+    assert.equal(evil.statusCode, 400);
+    assert.match(evil.body, /redirect_uri/);
+
+    // A public client has no secret; the Platform API must never accept it (not even with an empty or dummy secret).
+    for (const secret of ["", "x".repeat(40)]) {
+      const res = await h.app.inject({
+        url: "/platform-api/v1/access-requests",
+        headers: { authorization: `Basic ${Buffer.from(`${CLIENT}:${secret}`).toString("base64")}` },
+      });
+      assert.equal(res.statusCode, 401);
+    }
+  });
+
+  it("confidential clients are unchanged: no refresh tokens, secret required", async () => {
+    const d = h.config.clients.find((c) => c.client_id === "amar-gramer-golpo")!;
+    assert.ok(!d.public && d.client_secret.length >= 32);
+  });
+});
